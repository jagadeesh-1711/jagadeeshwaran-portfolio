PORT=5000
# Comma-separated frontend origins. Replace with your GitHub Pages URL after publishing.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# SMTP settings (for Gmail, use smtp.gmail.com and a Google App Password, not your normal password)
